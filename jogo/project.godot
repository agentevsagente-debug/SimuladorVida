; Simulador de vida: projeto do jogo (fase 1).

config_version=5

[application]

config/name="Simulador de vida"
config/version="0.3.0"
config/custom_user_dir_name="Simulador de vida"
config/use_custom_user_dir.template=true
run/main_scene="res://principal.tscn"
config/icon="res://arte/interface/icone_jogo_256.png"
config/windows_native_icon="res://arte/interface/icone_jogo.ico"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/flush_stdout_on_print=true
run/max_fps=30
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=33333
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]

window/size/viewport_width=480
window/size/viewport_height=178
window/size/window_width_override=960
window/size/window_height_override=356
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/energy_saving/keep_screen_on=false

[physics]

common/physics_ticks_per_second=10

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
